spring.application.name=backend_grupo4

spring.web.error.include-message=always
spring.web.error.include-binding-errors=always

# URL do banco
spring.datasource.url=jdbc:mysql://10.0.4.11:3306/boost?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC

# Usuário e senha
spring.datasource.username=backend
spring.datasource.password=root

# JPA / Hibernate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
# JWT
jwt.secret=${JWT_SECRET:mudar-esta-palavra-secreta-em-producao}
jwt.expiration=3600000

#DEBUG
logging.level.org.springframework.security=DEBUG
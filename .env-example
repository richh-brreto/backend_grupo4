# variáveis de ambiente
# copie este arquivo em um .env criado e preencha as variavéis

# ---------- Banco de dados (MySQL) ----------
# URL completa de conexão JDBC
DB_URL=jdbc:mysql://localhost:3306/boost?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
# Usuário do banco
DB_USERNAME=seu_usuario_mysql
# Senha do banco
DB_PASSWORD=sua_senha_mysql

# ---------- JWT ----------
# secret para assinar os tokens JWT.
# OBRIGATÓRIO: mínimo 32 caracteres. sem ele o app não sobe
# gere um valor forte, ex.: https://generate-secret.vercel.app/32 ou openssl rand -base64 32
JWT_SECRET=troque_por_um_segredo_com_no_minimo_32_caracteres
# Emissor e audiência do token (opcionais — têm defaults no application.properties)
JWT_ISSUER=boost-api
JWT_AUDIENCE=boost-web

# ---------- Gemini ----------
# Chave da API do Google Gemini, gerada em: https://aistudio.google.com/apikey
# Usada apenas no backend para gerar a análise da dashboard.
GEMINI_API_KEY=sua_chave_gemini_aqui (ou peça de algum membro vulgo richard)
